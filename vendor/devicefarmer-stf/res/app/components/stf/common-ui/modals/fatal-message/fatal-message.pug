.stf-fatal-message.stf-modal.mm-device-disconnect-dialog
  .modal-header
    h4.modal-title
      i.material-icons-round(aria-hidden='true') phone_disabled
      span(translate) Device was disconnected
    button(type='button', ng-click='cancel()', aria-label='Close').close
      i.material-icons-round(aria-hidden='true') close
  .modal-body
    p.mm-device-disconnect-reason(translate, ng-bind='device.likelyLeaveReason | likelyLeaveReason')
    .mm-device-disconnect-state
      .mm-device-disconnect-symbol(aria-hidden='true')
        i.material-icons-round phone_android
      .mm-device-disconnect-identity
        strong.device-name(ng-bind='device.enhancedName')
        span.device-status(ng-class='stateColor', ng-bind='device.enhancedStatePassive | translate')

  .modal-footer
    button.btn.mm-device-list-action(type='button', ng-click='second()')
      i.material-icons-round(aria-hidden='true') grid_view
      span(translate) Go to Device List
    button.btn.mm-reconnect-action(type='button', ng-click='ok()')
      i.material-icons-round(aria-hidden='true') refresh
      span(translate) Try to reconnect
