.stf-device-list.mm-console
  header.mm-topbar
    .mm-brand
      .mm-brand-mark(aria-hidden='true')
        img.mm-brand-icon(
          ng-src='/static/logo/exports/mobile-matrix-128{{mmTheme === "roseGlow" ? "-rose" : ""}}.png'
          alt='')
      .mm-brand-copy
        h1 Mobile Matrix
        device-list-stats(tracker='tracker')
    .mm-topbar-actions
      button.btn.mm-refresh-screenshots(
        type='button'
        ng-click='refreshScreenshots()'
        ng-disabled='screenshotState.running || !hasReadyDevices()'
        title='刷新设备当前屏幕截图'
        aria-label='刷新设备当前屏幕截图')
        i.fa.fa-refresh(ng-class='{"fa-spin": screenshotState.running}', aria-hidden='true')
        span {{screenshotState.running ? '刷新中' : '刷新截图'}}
      .mm-theme-switch(role='group', aria-label='主题切换')
        button.mm-theme-option(
          type='button'
          ng-click='setTheme("default")'
          ng-class='{"is-active": mmTheme === "default"}'
          aria-label='使用液态玻璃蓝主题'
          aria-pressed='{{mmTheme === "default"}}')
          span.mm-theme-dot.mm-theme-dot-blue
          span 液态玻璃蓝
        button.mm-theme-option(
          type='button'
          ng-click='setTheme("roseGlow")'
          ng-class='{"is-active": mmTheme === "roseGlow"}'
          aria-label='使用玫瑰流光主题'
          aria-pressed='{{mmTheme === "roseGlow"}}')
          span.mm-theme-dot.mm-theme-dot-rose
          span 玫瑰流光

  section.mm-device-panel
    .mm-toolbar
      .mm-toolbar-copy
        h2 设备矩阵
        p 状态来自 STF 实时设备通道
      .mm-toolbar-actions
        button.btn.mm-select-toggle(
          type='button'
          ng-click='toggleSelectionMode()'
          ng-class='{"is-active": selectionMode}'
          aria-pressed='{{selectionMode}}')
          i.fa.fa-check-square-o(aria-hidden='true')
          span {{selectionMode ? '退出多选' : '批量选择'}}
        .mm-batch-actions(ng-if='selectionMode')
          span.mm-selected-count 已选 {{selectedCount()}} 台
          button.btn.mm-batch-primary(
            type='button'
            ng-click='runBatch("lease")'
            ng-disabled='batchState.running || selectedCount() === 0')
            i.fa.fa-play(aria-hidden='true')
            span {{batchState.running && batchState.action === 'lease' ? '占用中' : '批量占用'}}
          button.btn.mm-batch-secondary(
            type='button'
            ng-click='runBatch("release")'
            ng-disabled='batchState.running || selectedCount() === 0')
            i.fa.fa-unlock(aria-hidden='true')
            span {{batchState.running && batchState.action === 'release' ? '释放中' : '批量释放'}}
        label.mm-search
          span.sr-only 搜索设备
          i.fa.fa-search(aria-hidden='true')
          input.form-control(
            type='search'
            autosave='deviceFilter'
            name='deviceFilter'
            ng-model='search.deviceFilter'
            ng-change='applyFilter(search.deviceFilter)'
            ng-model-options='{debounce: 150}'
            autocorrect='off'
            autocapitalize='off'
            spellcheck='false'
            focus-element='search.focusElement'
            text-focus-select
            accesskey='4'
            placeholder='搜索机型、序列号或状态')

    .mm-batch-result(
      ng-if='batchState.result'
      role='status'
      ng-class='{"has-errors": batchState.result.failed > 0}')
      .mm-batch-summary
        i.fa(
          ng-class='{"fa-check-circle": batchState.result.failed === 0, "fa-exclamation-circle": batchState.result.failed > 0}'
          aria-hidden='true')
        strong 操作完成
        span 成功 {{batchState.result.succeeded}} 台，失败 {{batchState.result.failed}} 台
      ul(ng-if='batchState.result.failed > 0')
        li(ng-repeat='item in batchState.result.results | filter:{status:"failed"} track by item.serial')
          code.selectable {{item.serial}}
          span.selectable {{item.error}}

    .mm-device-grid-wrap.selectable
      device-list-icons(
        tracker='tracker'
        columns='columns'
        sort='sort'
        filter='filter'
        selection-mode='selectionMode'
        selected-serials='selectedSerials'
        screenshots='screenshots')
