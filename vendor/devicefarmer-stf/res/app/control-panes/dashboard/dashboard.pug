section.mm-dashboard(aria-labelledby='mm-dashboard-title')
  h2#mm-dashboard-title.sr-only(translate) Dashboard

  .mm-dashboard-surface
    section.mm-dashboard-section(aria-labelledby='mm-dashboard-controls-title')
      header.mm-dashboard-section-heading
        i.material-icons-round(aria-hidden='true') tune
        h3#mm-dashboard-controls-title Quick Controls
      .mm-dashboard-section-grid.mm-dashboard-controls-grid
        .mm-dashboard-tool.mm-dashboard-tool-navigation
          div(ng-include='"control-panes/dashboard/navigation/navigation.pug"')
        .mm-dashboard-tool.mm-dashboard-tool-clipboard
          div(ng-include='"control-panes/dashboard/clipboard/clipboard.pug"')
        .mm-dashboard-tool.mm-dashboard-tool-shell(ng-if='$root.platform == "native"')
          div(ng-include='"control-panes/dashboard/shell/shell.pug"')

    section.mm-dashboard-section(aria-labelledby='mm-dashboard-apps-title')
      header.mm-dashboard-section-heading
        i.material-icons-round(aria-hidden='true') apps
        h3#mm-dashboard-apps-title Applications
      .mm-dashboard-section-grid.mm-dashboard-apps-grid
        .mm-dashboard-tool.mm-dashboard-tool-upload
          div(ng-include='"control-panes/dashboard/install/install.pug"')
        .mm-dashboard-tool.mm-dashboard-tool-apps
          div(ng-include='"control-panes/dashboard/apps/apps.pug"')

    section.mm-dashboard-section(aria-labelledby='mm-dashboard-developer-title')
      header.mm-dashboard-section-heading
        i.material-icons-round(aria-hidden='true') developer_mode
        h3#mm-dashboard-developer-title Developer
      .mm-dashboard-section-grid
        .mm-dashboard-tool.mm-dashboard-tool-debug
          div(ng-include='"control-panes/advanced/remote-debug/remote-debug.pug"')
