section.mm-execution-workspace(aria-labelledby='mm-execution-title')
  .mm-execution-heading
    div
      h2#mm-execution-title Group Execution
      p Run a registered Airtest task across selected devices.
    button.mm-execution-refresh(type='button', ng-click='refreshAirtestStatus()', ng-disabled='airtest.state === "checking" || airtest.state === "running"')
      i.material-icons-round(aria-hidden='true') refresh
      span Refresh engine

  ol.mm-execution-steps(aria-label='Execution steps')
    li.mm-execution-step
      span.mm-step-index 1
      span
        strong Select devices
        small {{airtestTargetCount() ? airtestTargetCount() + ' device selected' + (airtestTargetCount() === 1 ? '' : 's') : 'Select a usable device'}}
    li.mm-execution-step
      span.mm-step-index 2
      span
        strong Configure task
        small {{airtestReady() ? 'Choose a registered Airtest task' : 'Requires an available Airtest engine'}}
    li.mm-execution-step
      span.mm-step-index 3
      span
        strong Review & run
        small {{airtest.result ? 'Latest task completed' : 'Execute selected task on devices'}}

  .mm-execution-target
    .mm-execution-target-heading
      span Target devices
      button.mm-select-all(
        type='button'
        ng-class='{"is-deselect": airtestAllTargetsSelected()}'
        ng-click='toggleAllAirtestTargets()'
        ng-disabled='airtest.state === "running" || !airtestTargetDevices().length')
        span {{airtestAllTargetsSelected() ? 'Deselect all' : 'Select all'}}
    .mm-target-device-list
      button.mm-target-device(
        type='button'
        ng-repeat='target in airtestTargetDevices() track by target.serial'
        ng-click='toggleAirtestTarget(target)'
        ng-class='{selected: airtest.selectedSerials[target.serial]}'
        ng-disabled='airtest.state === "running"')
        i.material-icons-round(aria-hidden='true') {{airtest.selectedSerials[target.serial] ? 'check_circle' : 'phone_android'}}
        span.mm-target-device-copy
          strong {{target.name || target.model || 'Android device'}}
          small {{target.serial}}
        span.mm-target-device-state
          i.material-icons-round(aria-hidden='true') fiber_manual_record
          span {{target.state | translate}}
      p.mm-target-device-empty(ng-if='!airtestTargetDevices().length') No usable connected devices are available.

  .mm-execution-action(ng-class='{unavailable: !airtestReady() && !airtest.result}')
    .mm-task-card-heading
      i.material-icons-round.mm-task-card-icon(aria-hidden='true') smart_toy
      div.mm-task-card-copy
        span.mm-task-card-eyebrow Airtest task
        h3 Registered task execution
        p Choose a registered task and run it on the selected devices. Each run creates fresh evidence.
      .mm-task-card-status(ng-class='{running: airtest.state === "running", failed: airtest.result && airtest.result.status === "failed"}')
        i.material-icons-round(aria-hidden='true') {{airtest.state === 'running' ? 'progress_activity' : airtest.result && airtest.result.status === 'failed' ? 'error_outline' : airtest.result ? 'task_alt' : airtest.state === 'unavailable' ? 'error_outline' : 'check_circle'}}
        span {{airtestStatusLabel()}}

    p.mm-task-card-description {{airtest.state === 'unavailable' ? airtest.message : airtest.state === 'checking' ? 'Waiting for the local Airtest runtime.' : airtest.result ? airtest.message : 'Engine version ' + (airtest.version || 'ready') + ' is available.'}}

    .mm-execution-form
      label(for='mm-airtest-task') Select task
      .mm-task-select-row
        .mm-task-select-wrap
          select#mm-airtest-task.form-control(ng-model='airtest.task', ng-options='task.id as task.title for task in airtest.tasks', ng-disabled='!airtestReady() || airtest.state === "running"')
        button.mm-execution-run(type='button', ng-click='runAirtestAction()', ng-disabled='!airtestReady() || airtest.state === "running"')
          i.material-icons-round(aria-hidden='true') {{airtest.state === 'running' ? 'progress_activity' : 'play_arrow'}}
          span {{airtest.state === 'running' ? 'Running task' : 'Run task'}}

    .mm-execution-result(ng-if='airtest.result')
      span.mm-execution-result-label Result
      strong {{airtest.result.status === 'succeeded' ? 'Completed' : airtest.result.status === 'partial' ? 'Partially completed' : 'Failed'}}
      .mm-execution-result-device(ng-repeat='result in airtest.result.results track by result.serial')
        i.material-icons-round(aria-hidden='true') {{result.status === 'succeeded' ? 'check_circle' : 'error_outline'}}
        span {{result.serial}}
        span(ng-if='result.resolution') {{result.resolution[0]}} × {{result.resolution[1]}} · {{result.durationMs}} ms
        span(ng-if='!result.resolution') {{result.message}}
        .mm-execution-result-shots(ng-if='result.screenshots && result.screenshots.length')
          a.mm-execution-result-shot(ng-repeat='shot in result.screenshots track by shot.url', ng-href='{{shot.url}}', target='_blank', rel='noopener')
            img(ng-src='{{shot.url}}', alt='{{result.serial}} execution screenshot')
      span(ng-if='!airtest.result.results') {{airtest.result.message}}
